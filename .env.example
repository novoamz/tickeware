# Frontend → backend API base URL.
# Leave empty in dev to use Vite proxy (/api → http://localhost:3001).
# In production set the public API origin, e.g. https://api.example.com
VITE_API_URL=

# Set to false to disable history/persistence UI calls entirely
VITE_API_ENABLED=true

# Must match backend API_KEY when that env is set (still not a Redis secret)
# VITE_API_KEY=

# Tenant namespace (must be in backend ALLOWED_TENANTS)
# VITE_TENANT_ID=default
