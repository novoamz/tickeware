# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Optional shared secret. If set, clients must send X-API-Key or Authorization: Bearer
# API_KEY=change-me-long-random

# Multi-tenant
DEFAULT_TENANT=default
# Comma-separated allowlist (default tenant always included)
ALLOWED_TENANTS=default

# Retention
# Soft-deleted receipts kept this many days before POST /api/receipts/purge
SOFT_DELETE_RETENTION_DAYS=30
# Optional Redis TTL on live receipt keys (seconds). 0 = no expiry
RECEIPT_TTL_SECONDS=0
AUDIT_MAX_ENTRIES=500

# Upstash Redis REST — server-side only (never expose to the frontend)
# Get these from console.upstash.com → your database → REST API
# Ops: rotate token if it was ever embedded in a VITE_* browser build
# Ops: prefer ACL limited to tickeware:* prefix when available
UPSTASH_REDIS_REST_URL=https://YOUR-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN_HERE
